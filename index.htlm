<!doctype html>
<html lang="tr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#070707">
<title>Hızır Game Arena</title>

<style>
:root{
  --y:#ffcc00;
  --bg:#050505;
  --card:#10100d;
  --line:#3c3300;
  --muted:#aaa
}

*{box-sizing:border-box}

body{
  margin:0;
  background:var(--bg);
  color:#fff;
  font-family:Arial,Helvetica,sans-serif
}

a{
  text-decoration:none;
  color:inherit
}

.wrap{
  max-width:1120px;
  margin:auto;
  padding:0 18px
}

header{
  position:sticky;
  top:0;
  z-index:9;
  background:rgba(5,5,5,.93);
  border-bottom:1px solid #222
}

nav{
  height:76px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px
}

.brand{
  display:flex;
  align-items:center;
  gap:12px;
  font-weight:900
}

.brand img{
  width:52px;
  height:52px;
  object-fit:contain;
  border-radius:10px
}

.brand b{
  color:var(--y);
  font-size:22px;
  letter-spacing:2px
}

.btn{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  padding:13px 18px;
  border-radius:14px;
  background:#171717;
  border:1px solid #333;
  font-weight:800
}

.btn.y{
  background:var(--y);
  color:#060606;
  border-color:var(--y)
}

.hero{
  padding:72px 0;
  background:
    radial-gradient(
      circle at 75% 15%,
      rgba(255,204,0,.17),
      transparent 32%
    )
}

.hero-grid{
  display:grid;
  grid-template-columns:1.1fr .9fr;
  gap:36px;
  align-items:center
}

.tag{
  color:var(--y);
  font-weight:900;
  letter-spacing:2px
}

h1{
  font-size:clamp(42px,7vw,78px);
  line-height:1;
  margin:12px 0 18px
}

.lead{
  font-size:19px;
  line-height:1.65;
  color:#c7c7c7
}

.actions{
  display:flex;
  gap:10px;
  flex-wrap:wrap;
  margin-top:26px
}

.panel{
  background:linear-gradient(145deg,#18170d,#0b0b09);
  border:1px solid var(--line);
  border-radius:28px;
  padding:28px
}

.panel img{
  width:120px;
  height:120px;
  object-fit:contain;
  display:block;
  margin:0 auto 20px;
  border-radius:18px
}

.stats{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:10px
}

.stat{
  background:#080808;
  border:1px solid #27230c;
  border-radius:16px;
  padding:16px
}

.stat strong{
  display:block;
  color:var(--y);
  font-size:23px
}

.stat span{
  color:#999;
  font-size:13px
}

section{
  padding:58px 0
}

.notice{
  background:var(--y);
  color:#050505;
  border-radius:22px;
  padding:24px;
  font-size:22px;
  font-weight:900
}

.grid3{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:14px
}

.card{
  background:var(--card);
  border:1px solid #26220c;
  border-radius:21px;
  padding:22px
}

.card p{
  color:#aaa;
  line-height:1.6
}

.section-title{
  font-size:35px;
  margin:0 0 24px
}

.gallery-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:14px
}

.gallery-item{
  background:#0b0b0b;
  border:1px solid #2e290d;
  border-radius:22px;
  overflow:hidden;
  min-height:260px
}

.gallery-item img{
  width:100%;
  height:100%;
  min-height:260px;
  object-fit:cover;
  display:block;
  transition:transform .25s ease
}

.gallery-item:hover img{
  transform:scale(1.03)
}

.contact{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:14px
}

.float{
  position:fixed;
  right:16px;
  bottom:16px;
  background:#23c763;
  color:#fff;
  padding:14px 17px;
  border-radius:999px;
  font-weight:900;
  z-index:15
}

footer{
  border-top:1px solid #222;
  padding:30px 0;
  color:#888
}

@media(max-width:780px){
  .hero-grid,
  .contact,
  .grid3,
  .gallery-grid{
    grid-template-columns:1fr
  }

  .panel{
    order:-1
  }

  .hero{
    padding-top:42px
  }

  .gallery-item,
  .gallery-item img{
    min-height:220px
  }
}
</style>
</head>

<body>

<header>
  <div class="wrap">
    <nav>

      <a class="brand" href="/">
        <img src="/assets/logo.jpeg" alt="Hızır Game Arena">
        <div>
          <b>HIZIR</b><br>
          <small style="color:#aaa">GAME ARENA</small>
        </div>
      </a>

      <a class="btn" href="/admin.html">Yönetim Paneli</a>

    </nav>
  </div>
</header>

<main>

<section class="hero">
  <div class="wrap hero-grid">

    <div>
      <div class="tag" id="eyebrow"></div>
      <h1 id="title"></h1>
      <p class="lead" id="subtitle"></p>

      <div class="actions">
        <a class="btn y" id="wa1" target="_blank">WhatsApp</a>
        <a class="btn" id="ig1" target="_blank">Instagram</a>
      </div>
    </div>

    <div class="panel">

      <img src="/assets/logo.jpeg" alt="Hızır Game Arena">

      <div class="stats">

        <div class="stat">
          <strong id="s1v"></strong>
          <span id="s1l"></span>
        </div>

        <div class="stat">
          <strong id="s2v"></strong>
          <span id="s2l"></span>
        </div>

        <div class="stat">
          <strong id="s3v"></strong>
          <span id="s3l"></span>
        </div>

        <div class="stat">
          <strong id="s4v"></strong>
          <span id="s4l"></span>
        </div>

      </div>
    </div>

  </div>
</section>

<section>
  <div class="wrap">
    <div class="notice" id="announcement"></div>
  </div>
</section>

<section>
  <div class="wrap">

    <h2 class="section-title" id="aboutTitle"></h2>

    <div class="card">
      <p id="aboutText"></p>
    </div>

  </div>
</section>

<section>
  <div class="wrap">

    <h2 class="section-title">Oyuncu odaklı altyapı</h2>

    <div class="grid3">

      <div class="card">
        <h3>Yüksek Hz</h3>
        <p id="feature1"></p>
      </div>

      <div class="card">
        <h3>Güçlü Sistemler</h3>
        <p id="feature2"></p>
      </div>

      <div class="card">
        <h3>Fiber İnternet</h3>
        <p id="feature3"></p>
      </div>

    </div>
  </div>
</section>

<section id="gallerySection">
  <div class="wrap">

    <h2 class="section-title">Hızır Game Arena’dan Görüntüler</h2>

    <div class="gallery-grid">

      <div class="gallery-item" id="galleryBox1">
        <img id="galleryImage1" alt="Hızır Game Arena">
      </div>

      <div class="gallery-item" id="galleryBox2">
        <img id="galleryImage2" alt="Hızır Game Arena">
      </div>

      <div class="gallery-item" id="galleryBox3">
        <img id="galleryImage3" alt="Hızır Game Arena">
      </div>

    </div>

  </div>
</section>

<section>
  <div class="wrap">

    <h2 class="section-title">İletişim</h2>

    <div class="contact">

      <div class="card">
        <h3>Adres</h3>
        <p id="address"></p>
        <a class="btn" id="maps" target="_blank">Haritada Aç</a>
      </div>

      <div class="card">
        <h3>Bize ulaş</h3>

        <p>
          Telefon: <span id="phone"></span><br>
          Instagram: <span id="igtext"></span>
        </p>

        <a class="btn y" id="wa2" target="_blank">WhatsApp</a>
      </div>

    </div>
  </div>
</section>

</main>

<a class="float" id="wafloat" target="_blank">WhatsApp</a>

<footer>
  <div class="wrap">
    © <span id="year"></span> Hızır Game Arena
  </div>
</footer>

<script>
const defaults = {
  eyebrow:"GAZİANTEP'İN E-SPOR NOKTASI",

  title:"Oyunun merkezi<br>Hızır Game Arena.",

  subtitle:
    "Yüksek yenileme hızlı monitörler, güçlü sistemler ve 1000/1000 Mbps fiber internet ile rekabete hazır ol.",

  announcement:
    "Şehrin fenomen cafesi — Hızır Game Arena!",

  aboutTitle:
    "Gaziantep'te oyun deneyimini ileri taşıyoruz.",

  aboutText:
    "Hızır Game Arena, oyuncular için performans, konfor ve hızlı interneti tek çatı altında buluşturur.",

  feature1:
    "Akıcı ve rekabetçi oyun deneyimi için yüksek yenileme hızlı monitör seçenekleri.",

  feature2:
    "FPS oyunlarından güncel yapımlara kadar güçlü donanım altyapısı.",

  feature3:
    "Düşük gecikme ve yüksek hız için 1000/1000 Mbps fiber bağlantı.",

  s1v:"540 Hz",
  s1l:"Monitör seçeneği",

  s2v:"1000/1000",
  s2l:"Fiber internet",

  s3v:"RTX 4060",
  s3l:"Ekran kartı",

  s4v:"7800X3D",
  s4l:"İşlemci seçeneği",

  address:"Allaben Mah. Şair Nabi Sk. Şahinbey / Gaziantep",

  phone:"0530 308 98 92",

  instagram:"hizirgamecafe",

  whatsapp:"905303089892",

  maps:"https://maps.app.goo.gl/pYzKhzkgmbEi36BA6",

  galleryImage1:"",
  galleryImage2:"",
  galleryImage3:""
};

function t(id,value,html=false){
  const element = document.getElementById(id);

  if(!element){
    return;
  }

  if(html){
    element.innerHTML = value || "";
  }else{
    element.textContent = value || "";
  }
}

function applyGalleryImage(number,value){

  const image =
    document.getElementById("galleryImage" + number);

  const box =
    document.getElementById("galleryBox" + number);

  if(!image || !box){
    return;
  }

  if(!value){
    box.style.display = "none";
    return;
  }

  box.style.display = "block";
  image.src = value;

  image.onerror = function(){
    box.style.display = "none";
  };
}

function apply(data){

  const x = {
    ...defaults,
    ...data
  };

  [
    "eyebrow",
    "subtitle",
    "announcement",
    "aboutTitle",
    "aboutText",
    "feature1",
    "feature2",
    "feature3",
    "s1v",
    "s1l",
    "s2v",
    "s2l",
    "s3v",
    "s3l",
    "s4v",
    "s4l",
    "address",
    "phone"
  ].forEach(key=>{
    t(key,x[key]);
  });

  t("title",x.title,true);

  t(
    "igtext",
    "@" + String(x.instagram || "").replace(/^@/,"")
  );

  const wa =
    "https://wa.me/" +
    String(
      x.whatsapp ||
      x.phone ||
      ""
    ).replace(/\D/g,"");

  [
    "wa1",
    "wa2",
    "wafloat"
  ].forEach(id=>{

    const element =
      document.getElementById(id);

    if(element){
      element.href = wa;
    }
  });

  const instagramButton =
    document.getElementById("ig1");

  if(instagramButton){
    instagramButton.href =
      "https://instagram.com/" +
      String(x.instagram || "").replace(/^@/,"");
  }

  const mapsButton =
    document.getElementById("maps");

  if(mapsButton){
    mapsButton.href =
      x.maps || "#";
  }

  applyGalleryImage(
    1,
    x.galleryImage1
  );

  applyGalleryImage(
    2,
    x.galleryImage2
  );

  applyGalleryImage(
    3,
    x.galleryImage3
  );

  const gallerySection =
    document.getElementById("gallerySection");

  if(
    gallerySection &&
    !x.galleryImage1 &&
    !x.galleryImage2 &&
    !x.galleryImage3
  ){
    gallerySection.style.display = "none";
  }
}

apply(defaults);

fetch("/api/content",{
  cache:"no-store"
})
.then(response=>{

  if(!response.ok){
    return Promise.reject();
  }

  return response.json();
})
.then(apply)
.catch(()=>{});

document.getElementById("year").textContent =
  new Date().getFullYear();
</script>

</body>
</html>
